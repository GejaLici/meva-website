
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read access for everyone, but only authenticated users can write.
    match /blogPosts/{postId} {
      allow read: if true;
      // This is a placeholder. For a real app, you'd want more specific write rules.
      allow write: if request.auth != null; 
    }

    match /blogPosts/{postId}/translations/{locale} {
       allow read: if true;
       allow write: if request.auth != null;
    }

    // Allow anyone to create (submit the form), but only admins can read/delete.
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, delete: if request.auth != null;
      allow update: if false; // Never allow updates from the client
    }

    // Default deny rule for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
