
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all reads and writes to documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow anyone to create (write) a new document in the 'contactSubmissions' collection.
    // This is for public contact form submissions.
    // Disallow read, update, or delete of these submissions from the client-side.
    match /contactSubmissions/{submissionId} {
      allow create: if true; // Anyone can submit the form
      allow read, update, delete: if false; // No one can read/update/delete from client
    }

    // Example for blogPosts: Allow public read, but restrict writes.
    // You might want to adjust this based on how you manage blog content.
    // If content is managed via Firebase console or a secure admin panel,
    // client-side writes could be `if false;` or `if request.auth.uid != null && isAdmin;`
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if false; // Or more restrictive rules, e.g., for authenticated admins
    }
  }
}
