
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read for single posts, and list/write for authenticated users.
    match /blogPosts/{postId} {
      allow get: if true;
      allow list, write: if request.auth != null; 
    }

    // Translations follow the same pattern.
    match /blogPosts/{postId}/translations/{locale} {
       allow get: if true;
       allow list, write: if request.auth != null;
    }

    // Allow anyone to create (submit), but only authenticated users can read/list/delete.
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      // TEMPORARY: Make readable by anyone for debugging
      allow get, list: if true;
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // Default deny rule for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
