
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for blog posts
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if false; // Disallow client-side writes
    }
    
    // Allow anyone to create (write) a new document in the 'contactSubmissions' collection
    // This is for public contact form submissions.
    // Disallow read, update, or delete of these submissions from the client-side for security.
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Default deny rule for all other documents
    // This should come after specific rules
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
